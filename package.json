    "@fontsource/vt323": "^5.2.8",
    "dompurify": "^3.4.14",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "figlet": "^1.11.4",
    "marked": "^18.0.11",
    "mediainfo.js": "^0.3.7",
    "onnxruntime-web": "^1.29.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
