{
  "name": "concise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "build": "tsc -b && vite build",
